[Unit]
Description=Meka Studio, the web interface for Meka
Documentation=https://github.com/k4yt3x/meka-studio
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=you
Group=you
WorkingDirectory=~
ExecStart=/usr/local/bin/meka-studio serve
#Environment=XDG_RUNTIME_DIR=/run/user/1000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
